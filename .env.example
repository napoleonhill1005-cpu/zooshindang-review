# 복사해서 .env 로 저장하고 값 채우기 (또는 셸/Secrets로 주입)
USE_MOCK=1
SLACK_TOKEN=
SLACK_CHANNEL=#03_매장리뷰_현황
STORE_NAME=주신당 강남점

NAVER_STORE_ID=10037388
NAVER_BOOKING_BUSINESS_ID=1212070
NAVER_PLACE_ID=1916994932
CATCHTABLE_STORE_ID=64686

# 실제 수집 시 필요
# NAVER_COOKIE: DevTools cURL 의 -b '...' 전체 문자열
NAVER_COOKIE=
# CATCHTABLE_TOKEN: DevTools cURL 의 Authorization: Bearer 뒤 JWT 토큰
CATCHTABLE_TOKEN=

# 구글 (공식 Business Profile API) — 발급 절차는 docs/GOOGLE_SETUP.md 참고
# 미설정 시 구글 수집 자동 스킵. 현재 비즈니스 프로필 인증 대기 중이라 미가동 상태.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCOUNT_ID=
GOOGLE_LOCATION_ID=
